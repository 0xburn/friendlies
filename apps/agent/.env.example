# Copy to ".env" in this folder for local Electron dev (never commit .env).
# START_GG_TOKEN=your-start-gg-developer-token
#
# Optional: pin a specific bracket if auto-detect fails
# START_GG_CASHBOX_EVENT_ID=
# START_GG_CASHBOX_EVENT_SLUG=tournament/the-cashbox-21/event/your-event-slug
#
# Connect code → start.gg mapping: src/startgg/cashbox-entrant-map.json
# Use user:DISCRIMINATOR, participant:ATTENDEE_ID from /attendee/..., or a raw entrant id.
#
# Bracket opponent tag → Slippi code (next-match panel): src/startgg/cashbox-opponent-slippi-map.json
# Cashbox registration URL for the giveaway CTA (default: https://www.start.gg/tournament/the-cashbox-21/register).
# Use a full https URL, or a path only (e.g. tournament/foo/register) — relative values are normalized in the app.
# START_GG_CASHBOX_REGISTER_URL=
#
# Cashbox tab: load check-in / reporting steps from www.start.gg (undocumented REST).
# START_GG_TOKEN is sent as Bearer; for full responses you often need a browser session cookie:
# START_GG_WEB_COOKIE=session=...   (from DevTools → Application → Cookies for start.gg; do not commit)
# START_GG_CLIENT_VERSION=20        (optional; default 20)
# START_GG_TASK_COMPLETE_BODY={}    (optional JSON body for PUT .../task/{id}/complete)
# START_GG_DEBUG_REST=1             (log failed phase_group HTTP bodies)
#
# start.gg OAuth (optional): lets users link their start.gg account from the Cashbox tab.
# The client_secret is stored on the Supabase Edge Function env, NOT here.
# STARTGG_CLIENT_ID=your-startgg-oauth-app-client-id
